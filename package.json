{
  "name": "@w6w/ui",
  "version": "0.0.1",
  "description": "React components for w6w — a workflow platform. Build plugins, apps and integrations on them; see LICENSE for the one thing you may not do.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/w6w-io/w6w-ui.git"
  },
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./flow": {
      "types": "./src/flow.ts",
      "import": "./src/flow.ts"
    },
    "./code": {
      "types": "./src/code.ts",
      "import": "./src/code.ts"
    },
    "./styles.css": "./src/styles.css",
    "./code.css": "./src/code.css",
    "./styles.scss": "./src/styles.scss",
    "./styles/*": "./src/styles/_*.scss"
  },
  "files": [
    "src",
    "!src/**/*.stories.tsx",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "scripts": {
    "build": "pnpm build:css && tsc -b && vite build",
    "build:css": "node scripts/build-css.mjs",
    "check:css": "node scripts/build-css.mjs --check",
    "typecheck": "tsc -b --noEmit",
    "test": "node --import ./src/test-jsx-loader.mjs --test src/__tests__/*.test.ts src/components/__tests__/*.test.ts",
    "test:picker-layout": "bash test/picker-layout/run.sh",
    "test:expr-template": "bash test/expr-template/run.sh",
    "test:action-test-form": "bash test/action-test-form/run.sh",
    "test:copyable": "bash test/copyable/run.sh",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "lint": "biome check .",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "format": "biome format --write ."
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.0",
    "@uiw/react-codemirror": "^4.23.7",
    "@w6w/expr": "github:w6w-io/w6w-core#path:packages/expr",
    "@xyflow/react": "^12.3.6",
    "prism-react-renderer": "^2.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@storybook/react-vite": "^10.5.8",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "playwright-core": "1.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.102.0",
    "storybook": "^10.5.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.3.0"
  }
}
